<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VEDAR</AssemblyName>
    <RootNamespace>Vedar.Desktop</RootNamespace>
    <ApplicationIcon>Assets\vedar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>VEDAR — Твоят гласов приятел</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No telemetry, no tracing endpoints. -->
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vedar.Core\Vedar.Core.csproj" />
    <ProjectReference Include="..\Vedar.Infrastructure\Vedar.Infrastructure.csproj" />
    <ProjectReference Include="..\Vedar.Audio\Vedar.Audio.csproj" />
    <ProjectReference Include="..\Vedar.Speech\Vedar.Speech.csproj" />
    <ProjectReference Include="..\Vedar.AI\Vedar.AI.csproj" />
    <ProjectReference Include="..\Vedar.Commands\Vedar.Commands.csproj" />
    <ProjectReference Include="..\Vedar.Accessibility\Vedar.Accessibility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\vedar-logo-128.png" />
    <Resource Include="Assets\vedar-wordmark.png" />
    <EmbeddedResource Include="Assets\vedar.ico" LogicalName="Vedar.Desktop.vedar.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vedar.Tests" />
  </ItemGroup>
</Project>
